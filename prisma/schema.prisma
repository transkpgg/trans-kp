generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  nik         String   @unique
  full_name   String
  username    String   @unique
  password    String
  phone       String?
  jabatan     String
  role        String   @default("karyawan")
  branch_id   String?
  branch      Branch?  @relation(fields: [branch_id], references: [id])
  avatar_url  String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  attendances  Attendance[]
  hotel_visits HotelVisit[]
  etoll_histories EtollHistory[]
  driver_bons  DriverBon[]
  fuel_trips   FuelTripLog[]
  upd_calculations UpdCalculation[]
  vehicle_checklists VehicleChecklist[] @relation("TechnicianChecklists")
}

model Branch {
  id            String   @id @default(cuid())
  name          String
  address       String?
  latitude      Float
  longitude     Float
  radius_meters Int      @default(100)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  users      User[]
  schedules  WorkSchedule[]
}

model WorkSchedule {
  id            String   @id @default(cuid())
  branch_id     String
  branch        Branch   @relation(fields: [branch_id], references: [id])
  name          String
  start_time    String
  end_time      String
  days_of_week  String   // JSON array: "[1,2,3,4,5]"
  is_active     Boolean  @default(true)
}

model Attendance {
  id                  String   @id @default(cuid())
  user_id             String
  user                User     @relation(fields: [user_id], references: [id])
  branch_id           String
  date                String   // "2024-06-01"
  check_in_time       DateTime?
  check_in_lat        Float?
  check_in_lng        Float?
  check_in_photo_url  String?
  check_in_accuracy   Float?
  check_out_time      DateTime?
  check_out_lat       Float?
  check_out_lng       Float?
  check_out_photo_url String?
  check_out_accuracy  Float?
  status              String   @default("absent")
  gps_flag            String?
  notes               String?
  created_at          DateTime @default(now())
}

model HotelVisit {
  id                   String   @id @default(cuid())
  user_id              String
  user                 User     @relation(fields: [user_id], references: [id])
  hotel_name           String
  check_in_time        DateTime
  check_in_lat         Float?
  check_in_lng         Float?
  hotel_photo_url      String?
  selfie_check_in_url  String?
  check_out_time       DateTime?
  check_out_lat        Float?
  check_out_lng        Float?
  selfie_check_out_url String?
  duration_minutes     Int?
  notes                String?
}

model EtollCard {
  id              String   @id @default(cuid())
  card_number     String   @unique
  name            String
  nfc_uid         String?  @unique
  balance         Float    @default(0)
  status          String   @default("available") // available, in_use, lost
  last_used_at    DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  histories       EtollHistory[]
}

model EtollHistory {
  id             String    @id @default(cuid())
  card_id        String
  card           EtollCard @relation(fields: [card_id], references: [id])
  user_id        String
  user           User      @relation(fields: [user_id], references: [id])
  action         String    // "borrowed", "returned"
  balance_before Float?
  balance_after  Float?
  amount_used    Float?
  timestamp      DateTime  @default(now())
  notes          String?
}

model DriverBon {
  id              String   @id @default(cuid())
  bon_date        DateTime @default(now())
  nopol           String
  driver_id       String?
  driver_name     String
  driver_nik      String
  destination     String
  no_spd          String
  departure_date  DateTime
  amount          Float
  keterangan      String   // "Antar", "Jemput", "Pergi Pulang", "Inap"
  status          String   @default("belum_lunas") // "lunas", "belum_lunas"
  signature_url   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  driver          User?    @relation(fields: [driver_id], references: [id])
}

model Vehicle {
  id               String        @id @default(cuid())
  nopol            String        @unique
  name             String        // Nama / merk kendaraan, mis. Toyota Hiace
  type             String        @default("Mobil") // Mobil, Minibus, Bus, Truk, Motor
  capacity         Int?
  fuel_consumption Float?       // Konsumsi BBM standar: jarak (km) per 1 liter
  tank_capacity    Float?       @default(60) // Kapasitas tangki bahan bakar (Liter)
  notes            String?
  is_active        Boolean       @default(true)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  
  fuel_trips       FuelTripLog[]
}

model Destination {
  id          String   @id @default(cuid())
  city        String   @unique
  province    String?
  distance_km Int?
  notes       String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

// ==========================================
// MONITORING BBM & DETEKSI ANOMALI MODELS
// ==========================================

model FuelTripLog {
  id                 String        @id @default(cuid())
  vehicle_id         String?
  vehicle            Vehicle?      @relation(fields: [vehicle_id], references: [id])
  nopol              String
  driver_id          String?
  driver             User?         @relation(fields: [driver_id], references: [id])
  driver_name        String
  branch_id          String?
  trip_date          DateTime      @default(now())
  start_km           Float
  end_km             Float
  odo_distance       Float         // Jarak tempuh odometer (km) = end_km - start_km
  gps_distance       Float?        // Jarak tempuh GPS (km) jika tersedia
  fuel_start         Float?        // Level BBM awal (Liter)
  fuel_end           Float?        // Level BBM akhir (Liter)
  fuel_refill        Float         @default(0) // Pengisian BBM (Liter)
  fuel_cost          Float         @default(0) // Total biaya pembelian BBM (Rp)
  fuel_used          Float         // BBM terpakai (Liter)
  actual_kml         Float         // Konsumsi aktual km / liter = jarak / bbm terpakai
  actual_l100km      Float         // Liter / 100 km = (bbm terpakai / jarak) * 100
  cost_per_km        Float         // Biaya per km (Rp/km) = fuel_cost / jarak
  standard_kml       Float?        // Standar konsumsi kendaraan (km/L)
  diff_kml           Float?        // Selisih km/L (actual - standard)
  diff_percent       Float?        // Persentase selisih vs standar
  vehicle_status     String        @default("berhenti") // berjalan, berhenti, parkir, mesin_menyala, offline
  sensor_status      String        @default("belum_terhubung") // terhubung, belum_terhubung, offline
  current_fuel_level Float?        // Level BBM terkini (Liter)
  tank_capacity      Float?        @default(60) // Kapasitas tangki (Liter)
  fuel_percent       Float?        // Persentase level BBM (%)
  last_telemetry_at  DateTime?     // Waktu terakhir data sensor/GPS diterima
  last_location      String?       // Posisi/nama lokasi terakhir
  latitude           Float?
  longitude          Float?
  anomaly_status     String        @default("normal") // normal, perlu_diperiksa, indikasi_anomali
  calculation_method String        @default("full_to_full") // sensor_tangki, flow_meter, full_to_full
  receipt_url        String?       // Bukti struk pengisian jika ada
  notes              String?
  is_manual          Boolean       @default(true) // Menandai jika data diinput/diedit manual
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  anomalies          FuelAnomaly[]
}

model FuelAnomaly {
  id                 String       @id @default(cuid())
  trip_id            String?
  trip               FuelTripLog? @relation(fields: [trip_id], references: [id])
  nopol              String
  driver_name        String?
  timestamp          DateTime     @default(now())
  anomaly_type       String       // penurunan_tiba_tiba, pengisian_tak_tercatat, konsumsi_melebihi_standar, selisih_gps_odometer, sensor_terputus
  title              String
  description        String
  severity           String       @default("warning") // info, warning, critical
  location_name      String?
  latitude           Float?
  longitude          Float?
  diff_value         String?      // Contoh: "-12.5 Liter", "+35% deviasi", "Selisih 40 km"
  status             String       @default("baru") // baru, sedang_diperiksa, selesai, tidak_terbukti
  verified_by        String?
  verified_at        DateTime?
  verification_notes String?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
}

model FuelThresholdConfig {
  id                          String   @id @default(cuid())
  max_consumption_diff_percent Float    @default(20.0) // Ambang batas toleransi selisih konsumsi BBM (%)
  sudden_drop_liter           Float    @default(5.0)  // Ambang batas penurunan BBM mendadak (Liter)
  max_gps_odo_diff_percent    Float    @default(15.0) // Ambang batas toleransi selisih jarak GPS vs Odometer (%)
  offline_timeout_minutes     Int      @default(60)   // Ambang batas sensor offline / timeout (menit)
  updated_by                  String?
  updated_at                  DateTime @updatedAt
}

model FuelAuditLog {
  id          String   @id @default(cuid())
  entity_type String   // anomaly, trip, config
  entity_id   String
  action      String   // update_status, create_trip, update_config, edit_trip
  actor_name  String
  actor_nik   String?
  old_value   String?  // JSON string nilai sebelum
  new_value   String?  // JSON string nilai sesudah
  notes       String?  // Alasan / catatan audit
  timestamp   DateTime @default(now())
}

model UpdCalculation {
  id                  String   @id @default(cuid())
  driver_id           String?
  driver_name         String
  driver_nik          String?
  nopol               String?
  destination         String?
  no_spd              String?
  departure_time      DateTime
  return_time         DateTime
  total_days          Int      @default(1)
  meal_allowance      Float    @default(0)
  overnight_allowance Float    @default(0)
  cigarette_allowance Float    @default(0)
  total_amount        Float    @default(0)
  daily_breakdown     String   // JSON string of daily breakdown details
  notes               String?
  created_by          String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  driver              User?    @relation(fields: [driver_id], references: [id])
}

model VehicleChecklist {
  id                    String   @id @default(cuid())
  checklist_no          String?  @unique
  date                  DateTime @default(now())
  inspection_time       String   // e.g. "11:00"
  nopol                 String
  kilometer             Int      // Posisi Kilometer
  fuel_level            String   // e.g. "E", "1/4", "1/2", "3/4", "F"
  destination           String?  // e.g. "Pamekasan"
  
  // 1. Kondisi Mesin & Cairan
  engine_oil            String   // "Cukup", "Kurang", "Kosong"
  radiator_water        String   // "Cukup", "Kurang", "Kosong"
  battery_water         String   // "Cukup", "Kurang", "Kosong"
  power_steering_oil    String   // "Cukup", "Kurang", "Kosong"
  v_belt                String   // "Baik", "Kurang Baik", "Rusak"
  understell            String   // "Baik", "Kurang Baik", "Rusak"
  dashboard_indicator   String   // "Baik", "Kurang Baik", "Rusak"
  engine_condition      String   // "Baik", "Kurang Baik", "Rusak"

  // 2. Kelengkapan
  wheel_wrench          String   // "Ada", "Tidak Ada", "Rusak" (Kunci Roda)
  jack                  String   // "Ada", "Tidak Ada", "Rusak" (Dongkrak)
  safety_triangle       String   // "Ada", "Tidak Ada", "Rusak" (Segitiga Pengaman)
  first_aid_box         String   // "Ada", "Tidak Ada", "Rusak" (Kotak P3K)
  stnk_pkb              String   // "Ada", "Tidak Ada", "Rusak" (STNK + Pajak Kendaraan)

  // 3. Ban Utama
  main_tire_condition   String   // "Baik", "Kurang Baik", "Rusak"

  // 4. Ban Serep
  spare_tire_condition  String   // "Baik", "Kurang Baik", "Rusak"

  // 5. Accesories
  ac_condition          String   // "Dingin", "Kurang dingin", "Tidak dingin"
  radio_tape            String   // "Baik", "Tidak Ada", "Rusak"
  cigarette_lighter     String   // "Baik", "Tidak Ada", "Rusak"

  // 6. Lampu-Lampu
  lights_condition      String   // "Baik", "Tidak Ada", "Rusak"
  lights_notes          String?  // Keterangan lampu

  // 7. Rem
  brake_operation       String   // "Baik", "Kurang Baik", "Rusak" (Kerja Rem)
  brake_fluid           String   // "Baik", "Kurang", "Kosong" (Minyak Rem / Kopling)
  hand_brake            String   // "Baik", "Kurang Baik", "Rusak" (Rem Tangan)

  // Catatan umum & status kelayakan
  general_notes         String?
  status                String   @default("Baik / Laik Jalan") // "Baik / Laik Jalan", "Perlu Perbaikan"

  // Tanda Tangan & Personil
  driver_name           String?  // Nama Pengemudi (Yang membuat)
  driver_signature      String?  // Base64 Data URL tanda tangan pengemudi
  
  technician_id         String?  // ID Teknisi yang membuat/memeriksa
  technician_name       String   // Nama Teknisi / Perawatan (Menyetujui)
  technician_signature  String?  // Base64 Data URL tanda tangan teknisi
  
  supervisor_name       String?  // Nama Pengawas (Mengetahui)
  supervisor_signature  String?  // Base64 Data URL tanda tangan pengawas

  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  technician            User?    @relation("TechnicianChecklists", fields: [technician_id], references: [id])
}


